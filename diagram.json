{
  "version": 1,
  "author": "FrioLog - No de Borda Inteligente",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht1", "top": -105.3, "left": -140, "attrs": { "temperature": "5", "humidity": "55" } },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr1", "top": 185, "left": -250, "attrs": { "lux": "5" } },
    { "type": "wokwi-relay-module", "id": "relay1", "top": -80, "left": 200, "attrs": {} },
    { "type": "wokwi-buzzer", "id": "bz1", "top": 120, "left": 230, "attrs": { "volume": "0.3" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -140, "left": 360, "rotate": 90, "attrs": { "value": "220" } },
